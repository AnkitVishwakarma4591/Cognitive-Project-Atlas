# Project Atlas: Environment Configuration Template
# Copy this file to .env and configure your environment variables.
# NEVER commit .env to version control!

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
API_KEY=atlas-secret-key-2025

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=project_atlas
MYSQL_USER=root
MYSQL_PASSWORD=root_password_2025

# Read-only MySQL User (Enforces database safety for SQL tool)
MYSQL_READONLY_USER=atlas_readonly
MYSQL_READONLY_PASSWORD=AtlasReadOnly_Pass2025!

# LLM Provider Configuration: 'gemini', 'openai', 'anthropic', 'groq', 'ollama', or 'deterministic'
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# LLM API Keys (fill the one you use)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Vector DB Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security & Guardrails
CONFIDENCE_THRESHOLD=0.70
MAX_SQL_ROWS=50
SQL_QUERY_TIMEOUT_SECONDS=5.0
REQUEST_TIMEOUT_SECONDS=30.0
ENABLE_SEMANTIC_CACHE=true
